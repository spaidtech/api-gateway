# Application
APP_NAME=Multi-Tenant API Platform
APP_ENV=production
DEBUG=false

# PostgreSQL
POSTGRES_USER=api_gateway
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=api_platform

DATABASE_URL=postgresql+asyncpg://api_gateway:change_this_to_a_strong_password@postgres:5432/api_platform

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# URLs
PAYMENT_SUCCESS_URL=http://localhost:3000/payments/success
PAYMENT_CANCEL_URL=http://localhost:3000/payments/cancel
FRONTEND_URL=http://localhost:3000