# Application
APP_NAME=Multi-Tenant API Platform
APP_ENV=production
DEBUG=false
PORT=8000

# PostgreSQL (Docker internal networking uses service name 'postgres')
POSTGRES_USER=api_gateway
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
POSTGRES_DB=api_platform

DATABASE_URL=postgresql+asyncpg://api_gateway:replace_with_a_secure_postgres_password@postgres:5432/api_platform

# Redis (Docker internal networking uses service name 'redis')
REDIS_URL=redis://redis:6379/0

# Authentication & JWT (Minimum 32 random characters required in production)
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Razorpay Integration (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe Integration (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Application URLs
FRONTEND_URL=http://localhost:3000
PAYMENT_SUCCESS_URL=http://localhost:3000/payments/success
PAYMENT_CANCEL_URL=http://localhost:3000/payments/cancel